---
import Layout from '~/layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { render } from 'astro:content';
import { projects } from '~/data/projects';

const entry = await getEntry('pages', 'projekte');

if (!entry) {
  throw new Error('Could not find projekte page');
}

const { Content } = await render(entry);
const { title } = entry.data;

const metadata = {
  title: title,
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-normal mb-2 font-heading">
      {title}
    </h1>
    <Content />

    <div class="grid grid-cols-1 gap-5 mt-8">
      {
        projects.map((project) => (
          <article
            id={project.id}
            class="bg-[var(--bg-card)] border border-[var(--border)] rounded-[var(--radius)] p-6"
          >
            <h2 class="font-heading text-xl mb-3">{project.title}</h2>

            {project.description && (
              <p class="text-base text-secondary mb-4 leading-relaxed">{project.description}</p>
            )}

            {project.links && (
              <ul class="space-y-2">
                {project.links.map((link) => (
                  <li class="leading-relaxed">
                    <a href={link.href} class="text-accent hover:underline font-medium">
                      {link.label}
                    </a>
                    {link.note && <span class="text-muted"> — {link.note}</span>}
                  </li>
                ))}
              </ul>
            )}

            {
              project.groups?.map((group) => (
                <div class="mt-4">
                  <div class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
                    {group.label}
                  </div>
                  <ul class="space-y-1.5">
                    {group.links.map((link) => (
                      <li class="leading-relaxed">
                        <a href={link.href} class="text-accent hover:underline font-medium">
                          {link.label}
                        </a>
                        {link.note && <span class="text-muted"> — {link.note}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </article>
        ))
      }
    </div>
  </section>
</Layout>
