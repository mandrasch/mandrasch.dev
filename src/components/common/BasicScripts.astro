---
import { UI } from '~/config';
---

<script define:vars={{ defaultTheme: UI.theme }}>
  const toggleMenu = (open) => {
    const header = document.getElementById('header');
    const nav = document.querySelector('#header nav');
    const toggle = document.querySelector('[data-aw-toggle-menu]');
    const actions = document.querySelector('#header > div > div:last-child');

    if (open) {
      toggle?.classList.add('expanded');
      document.body.classList.add('overflow-hidden');
      header?.classList.add('h-screen', 'expanded', 'bg-page');
      nav?.classList.remove('hidden');
      actions?.classList.remove('hidden');
    } else {
      toggle?.classList.remove('expanded');
      document.body.classList.remove('overflow-hidden');
      header?.classList.remove('h-screen', 'expanded', 'bg-page');
      nav?.classList.add('hidden');
      actions?.classList.add('hidden');
    }
  };

  // Event delegation survives View Transitions (ClientRouter) swaps.
  document.addEventListener('click', (e) => {
    const target = e.target;

    if (target.closest('[data-aw-toggle-menu]')) {
      const btn = target.closest('[data-aw-toggle-menu]');
      toggleMenu(!btn.classList.contains('expanded'));
      return;
    }

    if (target.closest('[data-aw-toggle-color-scheme]')) {
      if (!defaultTheme.endsWith(':only')) {
        document.documentElement.classList.toggle('dark');
        localStorage.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      }
      return;
    }

    if (target.closest('#header nav')) {
      toggleMenu(false);
      return;
    }
  });

  // Sticky header styling on scroll (query the header fresh each tick).
  let lastKnownScrollPosition = window.scrollY;
  let ticking = false;

  const applyHeaderStylesOnScroll = () => {
    const header = document.querySelector('#header[data-aw-sticky-header]');
    if (!header) return;
    if (lastKnownScrollPosition > 60 && !header.classList.contains('scroll')) {
      header.classList.add('scroll');
    } else if (lastKnownScrollPosition <= 60 && header.classList.contains('scroll')) {
      header.classList.remove('scroll');
    }
    ticking = false;
  };
  applyHeaderStylesOnScroll();

  document.addEventListener(
    'scroll',
    () => {
      lastKnownScrollPosition = window.scrollY;
      if (!ticking) {
        window.requestAnimationFrame(() => applyHeaderStylesOnScroll());
        ticking = true;
      }
    },
    { passive: true }
  );

  const applyTheme = (theme) => {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  };

  const initTheme = () => {
    if (defaultTheme && defaultTheme.endsWith(':only')) {
      applyTheme(defaultTheme.replace(':only', ''));
      return;
    }
    if (localStorage.theme === 'dark') {
      applyTheme('dark');
    } else if (localStorage.theme === 'light') {
      applyTheme('light');
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      applyTheme('dark');
    } else {
      applyTheme('light');
    }
  };

  // ClientRouter resets the <html> class on navigation, dropping the `.dark` class.
  // Re-apply the persisted theme after each view-transition swap.
  document.addEventListener('astro:after-swap', initTheme);
</script>
