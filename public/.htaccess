Options -Indexes
RewriteEngine On

# ------------------------------------
# Canonical host: www → non-www
# ------------------------------------
RewriteCond %{HTTP_HOST} ^www\.matthias-andrasch\.eu$ [NC]
RewriteRule ^(.*)$ https://matthias-andrasch.eu/$1 [R=301,L]

# ------------------------------------
# Canonical URLs: strip explicit index.html
# ------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

# ------------------------------------
# Custom 404 page
# ------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------
# Compression for text-based responses
# ------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# ------------------------------------
# Cache control: short cache for HTML, long for hashed assets
# ------------------------------------
<IfModule mod_headers.c>
  # HTML: no cache, always fetch fresh
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed assets (JS, CSS, images): cache for 1 year
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|avif|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ------------------------------------
# 1) Old URLs: /YYYY/slug → /blog/YYYY/slug
#    This is when I had my blog on matthias-andrasch.eu,
#    and posts were at matthias-andrasch.eu/YYYY/<slug>/
# ------------------------------------
RewriteRule ^([0-9]{4})/(.*)$ /blog/$1/$2 [R=301,L]

# ------------------------------------
# 2) Old category URLs: /blog/cat/slug → /blog/kategorie/slug
# ------------------------------------
RewriteRule ^blog/cat/(.*)$ /blog/kategorie/$1 [R=301,L]

# Old category URLs without the /blog prefix: /cat/slug → /blog/kategorie/slug
RewriteRule ^cat/(.*)$ /blog/kategorie/$1 [R=301,L]

# ------------------------------------
# 3) Old Impressum URL: /blog/impressum-datenschutz/ → /impressum-datenschutz/
# ------------------------------------
RewriteRule ^blog/impressum-datenschutz/?$ /impressum-datenschutz/ [R=301,L]
