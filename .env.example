# Password configured in WordPress under Settings > Password Protect
# (Simple Password Protect plugin). The build logs in once and reuses the
# resulting wp_password_protect_auth cookie for the WordPress REST API.
WP_SITE_PASSWORD=

# Optional: override the WordPress REST API base URL (useful for local testing).
# WP_API_BASE=https://blog.matthias-andrasch.eu/wp-json/wp/v2
